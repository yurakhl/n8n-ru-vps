# Copy to .env, fill in, then: chmod 600 .env
# Never commit .env to git.

# Public domain of n8n (no https://, no IP). Its DNS A record must point to this server.
N8N_HOST=n8n.example.ru

# Pinned n8n image tag. Check the current stable tag at https://docs.n8n.io/hosting/installation/server-setups/docker-compose/
N8N_VERSION=2.47.3

# Encryption key for saved credentials. Generate once: openssl rand -hex 32
# Keep it secret and in your backup; if it is lost, saved credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=

# PostgreSQL database name and user (defaults are fine)
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Database password. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Timezone for schedules (IANA name)
GENERIC_TIMEZONE=Europe/Moscow
